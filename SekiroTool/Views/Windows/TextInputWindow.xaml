<Window x:Class="SekiroTool.Views.Windows.TextInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Input"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="350"
        MinHeight="140"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.5" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource TitleBarBrush}"
                    CornerRadius="3,3,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText"
                           Text="Input"
                           Foreground="White"
                           FontWeight="SemiBold"
                           Margin="10,6" />
            </Border>

            <StackPanel Grid.Row="1" Margin="15,15,15,5">
                <TextBlock x:Name="PromptText"
                           Foreground="{StaticResource TextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />
                <TextBox x:Name="InputBox"
                         KeyDown="InputBox_KeyDown" />
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="10,5,10,10">
                <Button Content="OK"
                        Width="75"
                        Height="26"
                        Margin="0,0,8,0"
                        Click="OkButton_Click" />
                <Button Content="Cancel"
                        Width="75"
                        Height="26"
                        Click="CancelButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
