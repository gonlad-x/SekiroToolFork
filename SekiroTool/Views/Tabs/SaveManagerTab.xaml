<UserControl x:Class="SekiroTool.Views.Tabs.SaveManagerTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:SekiroTool.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="500">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Expand/collapse arrow, themed to match the rest of the tool. -->
        <Style x:Key="TreeExpanderStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="14" Height="14">
                            <Path x:Name="Arrow"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 0 0 L 4 4 L 0 8 Z"
                                  Fill="#999999" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="Data" Value="M 0 0 L 8 0 L 4 5 Z" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Savefile/profiles paths are configured from Settings > Configure Save Manager. -->

        <!-- Profile section. Laid out the same way as the Event tab's sections: bordered container, bold header
             with an info bubble, then a horizontal StackPanel of controls. Keeping the ComboBox in a horizontal
             StackPanel next to buttons with the same Padding is what makes it match the Event dropdown's height -
             in a Grid row it was being stretched to whatever the row's tallest child happened to be. -->
        <Border Grid.Row="0"
                BorderThickness="1"
                BorderBrush="#333"
                CornerRadius="3"
                Margin="0,0,0,10">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Profile" FontWeight="Bold" />

                    <Border Background="#3498db"
                            CornerRadius="10"
                            Width="12"
                            Height="12"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="Savestates are grouped into profiles - one folder per profile. Set the folder they live in under Settings &gt; Configure Save Manager."
                            ToolTipService.InitialShowDelay='100'>
                        <TextBlock Text="i"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   FontSize="10" />
                    </Border>
                </StackPanel>

                <!-- Every control in this row is pinned to the same explicit height. Relying on the StackPanel to
                     equalise them left the dropdown a couple of pixels taller than the buttons, so the row is
                     stated outright rather than inferred. 26px is the natural height at this font: the app's
                     TextBox/ComboBox templates apply Padding as an inner margin, so anything under ~26 leaves
                     less than the line height and clips the text. -->
                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                    <ComboBox Width="180"
                              Height="26"
                              ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile}"
                              Margin="0,0,10,0" />

                    <Button Content="New Profile"
                            Command="{Binding NewProfileCommand}"
                            Height="26"
                            Padding="10,0"
                            Margin="0,0,10,0" />

                    <Button Content="Add Folder"
                            Command="{Binding CreateFolderCommand}"
                            Height="26"
                            Padding="10,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Savestates section -->
        <Border Grid.Row="1"
                BorderThickness="1"
                BorderBrush="#333"
                CornerRadius="3">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Savestates" FontWeight="Bold" />

                    <Border Background="#3498db"
                            CornerRadius="10"
                            Width="12"
                            Height="12"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="Import copies the game's current savefile in. Load overwrites the game's savefile - only takes effect from the main menu."
                            ToolTipService.InitialShowDelay='100'>
                        <TextBlock Text="i"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   FontSize="10" />
                    </Border>
                </StackPanel>

                <Border Grid.Row="1" BorderThickness="1" BorderBrush="#333">
                    <TreeView x:Name="SaveTree"
                              ItemsSource="{Binding RootItems}"
                              SelectedItemChanged="SaveTree_SelectedItemChanged"
                              MouseDoubleClick="SaveTree_MouseDoubleClick"
                              Background="Transparent"
                              BorderThickness="0">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4,3" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Row band: spans to the right edge so the whole row highlights,
                                                     not just the width of the text. -->
                                                <Border x:Name="Bd"
                                                        Grid.Row="0"
                                                        Background="Transparent"
                                                        SnapsToDevicePixels="True">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="16" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <ToggleButton x:Name="Expander"
                                                                      Grid.Column="0"
                                                                      Style="{StaticResource TreeExpanderStyle}"
                                                                      IsChecked="{Binding IsExpanded,
                                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                                                      ClickMode="Press" />

                                                        <ContentPresenter x:Name="PART_Header"
                                                                          Grid.Column="1"
                                                                          ContentSource="Header"
                                                                          HorizontalAlignment="Stretch"
                                                                          Margin="{TemplateBinding Padding}" />
                                                    </Grid>
                                                </Border>

                                                <ItemsPresenter x:Name="ItemsHost"
                                                                Grid.Row="1"
                                                                Margin="16,0,0,0"
                                                                Visibility="Collapsed" />
                                            </Grid>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="True">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{StaticResource HoverBrush}" />
                                                </Trigger>
                                                <!-- SourceName is the row band, not the item: a plain IsMouseOver trigger
                                                     would also light up every ancestor while hovering a child. -->
                                                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{StaticResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type viewModels:SaveEntryViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                        <Setter Property="Foreground" Value="#D32F2F" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="(read-only)"
                                               Foreground="#888888"
                                               FontStyle="Italic"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Add Folder" Command="{Binding CreateFolderCommand}" />
                                <MenuItem Header="Rename" Command="{Binding RenameCommand}"
                                          IsEnabled="{Binding HasSelection}" />
                                <MenuItem Header="Delete" Command="{Binding DeleteCommand}"
                                          IsEnabled="{Binding HasSelection}" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </Border>

                <!-- Actions -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Import"
                            Command="{Binding ImportCommand}"
                            IsEnabled="{Binding IsConfigured}"
                            Height="26"
                            Margin="0,0,5,0"
                            ToolTip="Copy the game's current savefile into the selected folder" />
                    <Button Grid.Column="1"
                            Content="Load"
                            Command="{Binding LoadCommand}"
                            IsEnabled="{Binding CanLoad}"
                            Height="26"
                            Margin="0,0,5,0"
                            ToolTip="Overwrite the game's savefile with the selected savestate (main menu only)" />
                    <Button Grid.Column="2"
                            Content="Replace"
                            Command="{Binding ReplaceCommand}"
                            IsEnabled="{Binding CanReplace}"
                            Height="26"
                            Margin="0,0,5,0"
                            ToolTip="Overwrite the selected savestate with the game's current savefile" />
                    <Button Grid.Column="3"
                            Content="{Binding ReadOnlyButtonText}"
                            Command="{Binding ToggleGameFileReadOnlyCommand}"
                            IsEnabled="{Binding IsConfigured}"
                            Height="26"
                            Width="80"
                            ToolTip="Toggle read-only on the game's savefile so the game can't overwrite it" />
                </Grid>
            </Grid>
        </Border>

        <!-- Status -->
        <StackPanel Grid.Row="3" Margin="0,6,0,0">
            <TextBlock Text="{Binding LoadBlockedReason}"
                       Foreground="#E0A030"
                       TextWrapping="Wrap"
                       Visibility="{Binding IsGameLoaded, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding StatusText}"
                       Foreground="#888888"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</UserControl>
